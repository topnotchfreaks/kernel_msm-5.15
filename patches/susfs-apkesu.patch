diff --git a/kernel/feature/susfs_compat.c b/kernel/feature/susfs_compat.c
new file mode 100644
index 0000000..d90cdc6
--- /dev/null
+++ b/kernel/feature/susfs_compat.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SUSFS compatibility layer for ApkeSU.
+ *
+ * susfs4ksu's kernel-side patch (50_add_susfs_in_gki-*.patch) injects a set of
+ * *manual* hook call sites into the kernel (fs/open.c, fs/stat.c, fs/exec.c,
+ * drivers/input/input.c, kernel/reboot.c, kernel/sys.c ...) and expects the
+ * KernelSU tree to export the matching entry points and gate keys.
+ *
+ * ApkeSU does not use manual hooks: su emulation, safe mode input detection and
+ * init.rc injection are all wired through its own kprobe / syscall-hook layer.
+ * Letting susfs' manual hooks run as well would double-handle those syscalls, so
+ * the gate keys below are defined *disabled* and the corresponding entry points
+ * are inert stubs. Everything susfs actually needs (path/mount/kstat hiding,
+ * uname & cmdline spoofing, open redirect, sus map) works through the kernel-side
+ * code plus ksu_handle_sys_reboot() in supercall/dispatch.c.
+ */
+
+#include <linux/fs.h>
+#include <linux/jump_label.h>
+#include <linux/types.h>
+#include <linux/uidgid.h>
+
+#include "klog.h" // IWYU pragma: keep
+
+/*
+ * Gate keys for susfs' manual hooks. Type and name are dictated by the
+ * kernel-side susfs patch; initialised to "false" so the hooks never fire.
+ */
+struct static_key_true ksu_su_compat_enabled = { .key = STATIC_KEY_INIT_FALSE };
+struct static_key_true ksu_is_input_hook_enabled = { .key = STATIC_KEY_INIT_FALSE };
+struct static_key_true ksu_is_init_rc_hook_enabled = { .key = STATIC_KEY_INIT_FALSE };
+
+/* su emulation: handled by ApkeSU's own sucompat hooks. */
+int ksu_handle_faccessat(int *dfd, const char __user **filename_user, int *mode, int *__unused_flags)
+{
+    return 0;
+}
+
+int ksu_handle_stat(int *dfd, const char __user **filename_user, int *flags)
+{
+    return 0;
+}
+
+int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv, void *envp, int *flags)
+{
+    return 0;
+}
+
+int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv, void *envp, int *flags)
+{
+    return 0;
+}
+
+/*
+ * setresuid: ApkeSU tracks uid transitions through its own hook
+ * (ksu_handle_setresuid_transition()), which also marks the process as umounted
+ * for susfs. This stub only satisfies the call site added to kernel/sys.c.
+ */
+int ksu_handle_setresuid(uid_t ruid, uid_t euid, uid_t suid)
+{
+    return 0;
+}
+
+/* init.rc size/content injection: handled by ApkeSU's own read/fstat hooks. */
+void ksu_handle_sys_read(unsigned int fd)
+{
+}
+
+void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr)
+{
+}
